---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

import { Image } from "astro:assets";

// components
import Button from "@components/Button/Button.astro";

// images
import heroImage from "@images/area_1.jpg";
import heroImageMobile from "@images/area_1.jpg";
---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
	<!-- background image -->
	<div class="absolute -z-10 h-full min-h-full w-full overflow-hidden">
		<div class="absolute inset-0 bg-black/10"></div>

		<Image
			src={heroImage}
			class="hidden h-auto min-h-full w-full object-cover object-bottom sm:block"
			alt="wedding"
			aria-hidden="true"
			loading="eager"
			height={1400}
		/>
		<Image
			src={heroImageMobile}
			class="h-auto min-h-full w-full object-cover sm:hidden"
			alt="wedding"
			aria-hidden="true"
			loading="eager"
			width={1200}
		/>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
		<!-- Hero text -->
		<div class="text-base-50 my-auto mr-auto max-w-[1200px] flex-col">
			<h1
				class="font-heading-1 text-4xl font-semibold text-pretty drop-shadow-[0_2px_2px_rgba(0,0,0,0.4)] md:text-7xl md:leading-tight"
			>
				The Cabin Hotel Lovina Bali
			</h1>
			<h2
				class="mt-8 text-lg tracking-widest text-pretty drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:max-w-[550px] md:text-2xl"
			>
				A comfortable hotel close to Lovina Beach, offering comfortable rooms at affordable prices.
			</h2>
			<div class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="primary"
					arrow="right"
					href="/rooms"
					class="text-lg text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:text-xl"
				>
					Our Rooms
				</Button>
			</div>
			<div class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="primary"
					arrow="right"
					href="https://www.thecabinhotelgroup.com/Hotel/the-cabin-hotel-lovina-220"
					class="text-2xl text-white bg-orange-600 hover:bg-orange-600/80 drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:text-3xl"
				>
					Reservation Now
				</Button>
			</div>
		</div>
	</div>
</section>
<div class="mx-auto my-10 h-full w-full">
	<video class="mx-auto h-full w-10/12 rounded-lg md:h-[400px] lg:h-[600px]" autoplay muted loop>
		<!-- <source src="https://lovina.thecabinhotelgroup.com/videos/video_lovina.mp4" type="video/mp4" /> -->
		<source src="http://localhost:4321/videos/video_lovina.mp4" type="video/mp4" />
	</video>
</div>
