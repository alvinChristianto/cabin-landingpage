---
/**
 * * Contact section for the website
 */

import { Image } from "astro:assets";

// components
import ContactForm from "@components/Forms/ContactForm.astro";
import Button from "@components/Button/Button.astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props as Props;

import ringsImage from "@assets/images/resto_1.jpg";
import wabutton from "@assets/images/WhatsAppButtonGreenSmall.png";
---

<section
	id="contact"
	class="mx-auto max-w-md scroll-mt-10 px-4 py-8 md:max-w-6xl md:py-12"
	class:list={[className]}
>
	<h2 class="h2 md:px-12 lg:text-6xl">Contact Us !</h2>
	<div class="grid gap-y-10 md:grid-cols-2">
		<div class="border-primary-300 pt-8 md:border-r md:pr-20 md:pl-12">
			<p class="description text-lg">For more information, don't hesitate to contact us !</p>
			<div class="mx-auto mt-8 aspect-square overflow-hidden">
				<Image
					src={ringsImage}
					alt="wedding rings"
					width={450}
					densities={[1.5, 2]}
					class="h-full w-full object-cover"
				/>
			</div>
		</div>
		<div class="md:pr-12 md:pl-20">
			<!-- <p class="description text-lg">Contact us on Whatsapp</p>

			<a
				class=""
				aria-label="Chat on WhatsApp" 
				href="https://wa.me/6282118888047?text=Hi,%20I%20Want%20to%20reserve%20room%20in%20The%20Cabin%20Hotel%20Lovina"
				target="_blank"
			>
				{" "}
				{/* <img alt="Chat on WhatsApp" src="WhatsAppButtonGreenLarge.png" /> */}
				<Image src={wabutton} width={200} alt="Whatsapp button for the cabin hotel" />
			</a> -->
			<Button
				variant="primary"
				arrow="right"
				href="https://www.thecabinhotelgroup.com/Hotel/the-cabin-hotel-lovina-220"
				class="bg-orange-600 text-2xl text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] hover:bg-orange-600/80 md:text-3xl"
			>
				Reservation Now
			</Button>
		</div>
	</div>
</section>
